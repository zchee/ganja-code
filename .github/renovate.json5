// Renovate is the one dependency updater here; Dependabot runs alerts-only
// (no dependabot.yml, automated security fixes disabled), so every update PR
// has a single author and a single cadence. https://docs.renovatebot.com/rust/
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  timezone: 'Asia/Tokyo',
  labels: ['deps'],

  // Only the two surfaces this repository actually has. Everything else —
  // including the rust-toolchain manager — stays off: the toolchain pins the
  // non-dated `nightly` channel on purpose, and there is nothing there to
  // bump (rust-toolchain.toml's own comment is the authority).
  enabledManagers: ['cargo', 'github-actions'],

  // One batch a week, not a PR per crate: every version lives in the root
  // manifest with a rationale comment, and reviewing the week's movement in
  // one sitting is what that convention is for.
  schedule: ['before 9am on monday'],

  // The root manifest is the source of truth, so an update rewrites the
  // requirement there rather than drifting the lockfile away from it.
  rangeStrategy: 'bump',

  // The publish-then-poison window: a malicious release is usually caught
  // (yanked, RustSec-advised) within days of landing, so nothing is taken
  // the week it appears. Vulnerability fixes bypass this, below.
  minimumReleaseAge: '5 days',

  // A weekly `cargo update` for the transitive tree the manifest does not
  // name — the half of the graph `rangeStrategy: bump` never touches.
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 9am on monday'],
  },

  // OSV-fed fix PRs replace the Dependabot security updates this repo turned
  // off; a vulnerability fix skips both the schedule and the release-age
  // gate, because waiting is the wrong default only there.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ['deps', 'security'],
  },

  // The repository's commit convention is `scope: intent`.
  commitMessagePrefix: 'deps:',

  // Granularity by compatibility class, not per crate (PR #9's lesson, both
  // ways): one breaking bump must not hold the harmless batch hostage, and a
  // move-together family split into per-crate PRs would sit permanently red.
  // Order matters — later rules override earlier ones, so the families are
  // re-grouped last.
  packageRules: [
    // Semver-compatible movement lands as the one weekly batch.
    {
      matchManagers: ['cargo'],
      matchUpdateTypes: ['minor', 'patch'],
      matchCurrentVersion: '>=1.0.0',
      groupName: 'cargo compatible',
    },
    {
      matchManagers: ['cargo'],
      matchUpdateTypes: ['patch'],
      matchCurrentVersion: '<1.0.0',
      groupName: 'cargo compatible',
    },
    // The breaking class — majors, and 0.x minors, which cargo's caret
    // treats as majors — goes one PR per crate: a red one blocks nothing
    // else, and each is a deliberate read anyway in a manifest where every
    // version carries its rationale.
    {
      matchManagers: ['cargo'],
      matchUpdateTypes: ['major'],
      groupName: null,
    },
    {
      matchManagers: ['cargo'],
      matchUpdateTypes: ['minor'],
      matchCurrentVersion: '<1.0.0',
      groupName: null,
    },
    // Lockstep families move as one PR or not at all usefully: webfetch
    // walks the DOM beneath htmd through the rcdom types it re-exports only
    // partially (the root manifest's own comment on markup5ever_rcdom), and
    // the ripgrep and ratatui sets version together upstream.
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['htmd', 'html5ever', 'markup5ever', 'markup5ever_rcdom'],
      groupName: 'html5ever family',
    },
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['grep-matcher', 'grep-regex', 'grep-searcher', 'ignore'],
      groupName: 'ripgrep internals',
    },
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['ratatui', 'ratatui-textarea'],
      groupName: 'ratatui family',
    },
    {
      matchManagers: ['github-actions'],
      groupName: 'github actions',
    },
  ],
}
