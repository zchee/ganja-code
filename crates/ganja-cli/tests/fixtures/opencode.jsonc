{
  // Every key here is one opencode v1.18.13 accepts. This is the importer's
  // fixture rather than a config anyone runs: it exists to have one of each
  // shape the mapping has a rule for, including the ones that must NOT survive.
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-5",
  // Nothing but a token: opencode would have expanded it before parsing, so
  // carrying it across would name a model that does not exist.
  "small_model": "{env:OPENCODE_SMALL_MODEL}",
  "default_agent": "plan",
  "shell": "/bin/zsh",
  "theme": "tokyonight",
  // Both keys exist in ganja too, and neither means what it means here:
  // ganja binds a curated handful of actions of its own, and its status bar
  // is not opencode's. Carried across, they would name actions and options
  // that do not exist.
  "keybinds": { "session_share": "<leader>s", "app_exit": "ctrl+x" },
  "tui": { "scroll_speed": 3 },
  "instructions": [
    "AGENTS.md",
    "{file:./docs/house.md}",
    "docs/{env:TEAM}/style.md",
    "https://example.invalid/house.md",
  ],
  // The legacy spelling of `permission`, which the explicit rules below
  // partly override.
  "tools": {
    "webfetch": false,
    "write": true,
    "bash": true,
  },
  "permission": {
    "bash": { "git status": "allow", "git *": "ask", "*": "deny" },
    "edit": "ask",
    "read": "allow",
  },
  "agent": {
    "review": {
      "model": "anthropic/claude-haiku-4-5",
      "description": "reads a diff and complains",
      "mode": "subagent",
      "temperature": 0.2,
      "top_p": 0.9,
      "steps": 40,
      "color": "#ff0000",
      "variant": "thinking",
      "options": { "reasoning": true },
      "tools": { "edit": false },
      "permission": { "webfetch": "allow" },
    },
  },
  "mode": {
    "ship": {
      "prompt": "You ship what is already green.",
      "hidden": false,
    },
  },
  "command": {
    "release": {
      "template": "cut a release for $ARGUMENTS",
      "description": "tag and push",
      "agent": "build",
      "variant": "fast",
      "subtask": true,
    },
  },
  "provider": {
    // A provider ganja ships: refused, because a `provider` entry naming one
    // would never be reached — and its key gets a row of its own whatever
    // happens to the entry around it.
    "anthropic": {
      "options": {
        "apiKey": "sk-fixture-0000-not-a-real-key",
        "baseURL": "https://example.invalid/v1",
      },
    },
    // One ganja can carry: an SDK it has a wire for, and somewhere to point it.
    "local-llama": {
      "npm": "@ai-sdk/openai-compatible",
      "models": { "tiny": { "name": "Tiny" } },
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "headers": { "x-route": "gpu-0" },
        "organization": "acme",
      },
    },
  },
  "mcp": {
    "fs": {
      "type": "local",
      "command": ["mcp-fs", "--root", "."],
      "cwd": "./servers",
      "environment": { "MCP_FS_MODE": "ro" },
      "enabled": true,
      "timeout": 45000,
    },
    "docs": {
      "type": "remote",
      "url": "https://mcp.example.invalid/mcp",
      "headers": { "Authorization": "Bearer {env:DOCS_TOKEN}" },
      // Ganja does not authenticate itself to an MCP server, so this is the
      // one sub-key of a remote entry that must not survive.
      "oauth": { "clientId": "opencode" },
    },
    // No `type`, so it describes no server: the shape somebody writes to
    // switch off a server another tier defined, with nothing here to switch.
    "legacy": { "enabled": false },
  },
  "lsp": {
    // A server ganja ships too, switched off the one way that needs no
    // command.
    "rust": { "disabled": true },
    // One opencode ships a definition for and ganja does not, and the entry
    // leans on it: upstream lets a command stand alone because the extensions
    // come from the builtin, and there is nothing here to inherit them from.
    "typescript": { "command": ["typescript-language-server", "--stdio"] },
    // Also one of opencode's builtins, but this entry leans on nothing: it
    // names the program and the files, which is the whole of what a server is
    // here, so it travels under its own name.
    "deno": { "command": ["deno", "lsp"], "extensions": [".ts", ".tsx"] },
    // A server that describes itself completely, which travels as it stands.
    "nickel": {
      "command": ["nls"],
      "extensions": [".ncl"],
      "env": { "NICKEL_LOG": "info" },
      "initialization": { "eval": { "limit": 500 } },
    },
  },
  "snapshot": false,
  "compaction": { "auto": false, "tail_turns": 4 },
  "autoshare": true,
  "username": "nobody",
  "definitely_not_an_opencode_key": 1,
}
